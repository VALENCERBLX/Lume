		app = app,\
		scope = scope,\
		instance = root :: GuiObject,\
		refs = refs,\
		bindings = {},\
		events = {},\
		owner = nil,\
		dead = false,\
\
		kind = \"keybind\",\
		desired = Vector2.new(0, theme.size.control),\
		margin = 0,\
		fill = true,\
		grow = false,\
		enabled = true,\
		measured = false,\
