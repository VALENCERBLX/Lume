local options = (type(_G.LumeInstall) == "table" and _G.LumeInstall or {}) :: any

local parent = options.parent or game:GetService("ReplicatedStorage")
local name = options.name or "Lume"
local silent = options.silent == true

local function say(message: string)
	if not silent then
		print(message)
	end
end

local existing = parent:FindFirstChild(name)

if existing then
	if options.overwrite == false then
		warn(`Lume: {name} already exists and overwrite is off; nothing was installed`)
		return
	end

	existing:Destroy()

	say(`Lume: replaced the existing {parent:GetFullName()}.{name}`)
end

local byPath = {}

for _, entry in MODULES do
	local path, className, source = entry[1], entry[2], entry[3]

	local instance = Instance.new(className)
	local parentPath = string.match(path, "^(.+)/[^/]+$")

	--// the root honours the `name` option; everything below keeps its own name
	instance.Name = if parentPath then string.match(path, "([^/]+)$") else name

	if source then
		--// Source is only writable from the command bar or a plugin
		local ok, err = pcall(function()
			instance.Source = source
		end)

		if not ok then
			warn(`Lume: could not write {path} ({err}). Run this from the Studio command bar or a plugin.`)
			return
		end
	end

	instance.Parent = if parentPath then byPath[parentPath] else parent
	byPath[path] = instance
end

local installed = parent:FindFirstChild(name)

if installed then
	installed:SetAttribute("LumeVersion", "0.1.0")
	installed:SetAttribute("LumeInstalledAt", os.time())

	if options.select ~= false then
		local Selection = game:GetService("Selection")

		pcall(function()
			Selection:Set({ installed })
		end)
	end
end

say(`Lume installed to {parent:GetFullName()}.{name} ({#MODULES} instances)`)
