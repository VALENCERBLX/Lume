	self.desired = Vector2.new(self.iconSize, self.iconSize)\
	self.measured = true\
\
	return self.desired\
end\
\
Element.install(Icon)\
\
return Icon\
"},
{"Lume/Elements/Keybind","ModuleScript","--!strict\
\
--- A key capture row: a label and a button that, once clicked, binds the next\
--- key you press.\
---\
