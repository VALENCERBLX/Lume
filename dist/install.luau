	local fields: Fields = {\
		app = app,\
		scope = scope,\
		instance = root :: GuiObject,\
		refs = refs,\
		bindings = {},\
		events = {},\
		owner = nil,\
		dead = false,\
\
		kind = \"divider\",\
		desired = Vector2.new(0, theme.stroke.hairline),\
