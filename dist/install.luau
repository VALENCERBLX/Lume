	titlebar: Frame,\
	titleIcon: ImageLabel,\
	titleText: TextLabel,\
	subtitle: TextLabel,\
	close: TextButton,\
\
	content: ScrollingFrame,\
	padding: UIPadding,\
	layout: UIListLayout,\
