--- Generates `dist/install.luau`: a single script that, pasted into the Studio
--- command bar, recreates the whole Lume tree under ReplicatedStorage.
---
--- Run with `lune run scripts/build-installer`.
---
--- The source tree already uses instance requires (`require(script.Parent.X)`),
--- so nothing has to be rewritten on the way through — the packer only walks
--- the tree, inlines each module's source, and emits a manifest.

local fs = require("@lune/fs")
local luau = require("@lune/luau")

type Entry = { path: string, class: string, source: string? }

local ROOT = "Lume"

local entries: { Entry } = {}

local function findInit(dir: string): string?
	for _, name in { "init.lua", "init.luau" } do
		if fs.isFile(`{dir}/{name}`) then
			return `{dir}/{name}`
		end
	end

	return nil
end

local function walk(dir: string, path: string)
	local names = fs.readDir(dir)

	table.sort(names)

	for _, name in names do
		local full = `{dir}/{name}`

		if fs.isDir(full) then
			local childPath = `{path}/{name}`
			local init = findInit(full)

			--// a folder with an init becomes a ModuleScript, matching Rojo
			entries[#entries + 1] = {
				path = childPath,
				class = if init then "ModuleScript" else "Folder",
				source = if init then fs.readFile(init :: string) else nil,
			}

			walk(full, childPath)
		elseif string.match(name, "%.luau?$") and not string.match(name, "^init%.luau?$") then
			entries[#entries + 1] = {
				path = `{path}/{string.gsub(name, "%.luau?$", "")}`,
				class = "ModuleScript",
				source = fs.readFile(full),
			}
		end
	end
end

local rootInit = findInit("src")

entries[#entries + 1] = {
	path = ROOT,
	class = if rootInit then "ModuleScript" else "Folder",
	source = if rootInit then fs.readFile(rootInit :: string) else nil,
}

walk("src", ROOT)

local lines: { string } = {
	"--!nocheck",
	"",
	"--[[",
	"\tLume installer (generated by scripts/build-installer — do not edit)",
	"",
	"\tBuilds the library into your place as ModuleScripts, ready to require().",
	"",
	"\tStudio command bar (one line):",
	"",
	"\t  loadstring(game:GetService(\"HttpService\"):GetAsync(\"<RAW_URL>/dist/install.luau\"))()",
	"",
	"\tOptions (set before running, all optional):",
	"",
	"\t  _G.LumeInstall = {",
	"\t      parent    = game:GetService(\"ReplicatedStorage\"),  --// where to build",
	"\t      name      = \"Lume\",                                --// root instance name",
	"\t      overwrite = true,                                  --// replace an existing install",
	"\t      select    = true,                                  --// select the root when done",
	"\t      silent    = false,                                 --// suppress output",
	"\t  }",
	"]]",
	"",
	"local MODULES = {",
}

for _, entry in entries do
	local source = if entry.source then string.format("%q", entry.source) else "nil"

	lines[#lines + 1] = string.format("{%q,%q,%s},", entry.path, entry.class, source)
end

lines[#lines + 1] = [==[
}

local options = (type(_G.LumeInstall) == "table" and _G.LumeInstall or {}) :: any

local parent = options.parent or game:GetService("ReplicatedStorage")
local name = options.name or "Lume"
local silent = options.silent == true

local function say(message: string)
	if not silent then
		print(message)
	end
end

local existing = parent:FindFirstChild(name)

if existing then
	if options.overwrite == false then
		warn(`Lume: {name} already exists and overwrite is off; nothing was installed`)
		return
	end

	existing:Destroy()

	say(`Lume: replaced the existing {parent:GetFullName()}.{name}`)
end

local byPath = {}

for _, entry in MODULES do
	local path, className, source = entry[1], entry[2], entry[3]

	local instance = Instance.new(className)
	local parentPath = string.match(path, "^(.+)/[^/]+$")

	--// the root honours the `name` option; everything below keeps its own name
	instance.Name = if parentPath then string.match(path, "([^/]+)$") else name

	if source then
		--// Source is only writable from the command bar or a plugin
		local ok, err = pcall(function()
			instance.Source = source
		end)

		if not ok then
			warn(`Lume: could not write {path} ({err}). Run this from the Studio command bar or a plugin.`)
			return
		end
	end

	instance.Parent = if parentPath then byPath[parentPath] else parent
	byPath[path] = instance
end

local installed = parent:FindFirstChild(name)

if installed then
	installed:SetAttribute("LumeVersion", "0.1.0")
	installed:SetAttribute("LumeInstalledAt", os.time())

	if options.select ~= false then
		local Selection = game:GetService("Selection")

		pcall(function()
			Selection:Set({ installed })
		end)
	end
end

say(`Lume installed to {parent:GetFullName()}.{name} ({#MODULES} instances)`)
]==]

local bundle = table.concat(lines, "\n")

--// self-check: a generated installer that does not compile is worse than none
local ok, err = pcall(luau.load, bundle, { debugName = "install.luau" })

assert(ok, `generated installer does not compile: {err}`)

if not fs.isDir("dist") then
	fs.writeDir("dist")
end

fs.writeFile("dist/install.luau", bundle)

print(`bundled dist/install.luau ({math.round(#bundle / 1024)}K, {#entries} instances)`)
